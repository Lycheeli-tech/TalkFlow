# Shared
APP_ENV=development

# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# Only use the local Supabase JWT secret here. Never commit a real value.
SUPABASE_JWT_SECRET=
# Server-only. Never expose this value through a NEXT_PUBLIC variable.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI providers remain fake until their owning milestone selects a provider.
LLM_PROVIDER=fake
PROFILE_EXTRACTOR_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_PROFILE_MODEL=gpt-5.6-luna
DOCUMENT_STORAGE_PROVIDER=fake
STT_PROVIDER=fake
TTS_PROVIDER=fake
