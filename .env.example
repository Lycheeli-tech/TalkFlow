# Shared
APP_ENV=development

# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# Only use the local Supabase JWT secret here. Never commit a real value.
SUPABASE_JWT_SECRET=
# Server-only. Never expose this value through a NEXT_PUBLIC variable.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI providers remain fake until live activation selects a provider.
LLM_PROVIDER=fake
PROFILE_EXTRACTOR_PROVIDER=fake
BAILIAN_API_KEY=
BAILIAN_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BAILIAN_TEXT_MODEL=qwen3.7-flash
BAILIAN_STT_MODEL=qwen3-asr-flash
BAILIAN_TTS_MODEL=qwen3-tts-flash
BAILIAN_TTS_VOICE=Cherry
DOCUMENT_STORAGE_PROVIDER=fake
STT_PROVIDER=fake
TTS_PROVIDER=fake
AUDIO_STORAGE_PROVIDER=fake
MAX_AUDIO_BYTES=20971520
